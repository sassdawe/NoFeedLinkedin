{
  "manifest_version": 3,
  "name": "No Feed LinkedIn",
  "version": "1.0.0",
  "description": "Redirects the LinkedIn feed to the Jobs page so you can focus on finding a job.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["webNavigation", "declarativeNetRequest"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "redirect_feed",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
